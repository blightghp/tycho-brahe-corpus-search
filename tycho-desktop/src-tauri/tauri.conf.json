{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tycho Brahe Search",
  "version": "0.1.0",
  "identifier": "br.unicamp.iel.tycho-brahe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tycho Brahe - Pesquisa Sintática Gerativa",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/tycho_backend",
      "bin/tycho_m4_search"
    ],
    "resources": [
      "../../corpus_data/corpus_fase3.db",
      "../../corpus_data/corpus_cartografia.db"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

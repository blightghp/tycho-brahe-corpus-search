{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tycho Brahe Search",
  "version": "0.2.0",
  "identifier": "br.unicamp.iel.tycho-brahe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tycho Brahe - Pesquisa Sintática Gerativa",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Tycho Brahe Search",
    "homepage": "https://www.tycho.iel.unicamp.br/",
    "copyright": "Tycho Brahe Search v0.2.0. Os direitos do Corpus Historico do Portugues Tycho Brahe seguem os termos oficiais do IEL/UNICAMP.",
    "shortDescription": "Cliente complementar para busca sintática rastreável.",
    "longDescription": "Prévia técnica do cliente Tycho Brahe Search. Não inclui nem licencia o Corpus Histórico do Português Tycho Brahe ou o artefato M3.",
    "licenseFile": "installer/TERMOS_DE_USO_E_DIREITOS.txt",
    "externalBin": [
      "bin/tycho_backend",
      "bin/tycho_m4_search"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Tycho Brahe Search"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
